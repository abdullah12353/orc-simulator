{
  "name": "orc-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @orc/web && npm run typecheck -w @orc/clock",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/content/test/**/*.test.ts\" \"packages/sim/test/**/*.test.ts\" \"apps/web/test/**/*.test.ts\"",
    "test:db": "node scripts/test-db.mjs",
    "audio:placeholders": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/placeholder-audio.ts",
    "voices": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-voices.ts",
    "voices:dry": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-voices.ts --dry",
    "voices:design": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-voices.ts --design",
    "voices:save": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-voices.ts --save",
    "voices:pick": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-voices.ts --pick",
    "content:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-content.ts",
    "names:register": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/register-name.ts",
    "db:start": "node scripts/db-lock.mjs -- npx supabase start",
    "db:lock": "node scripts/db-lock.mjs",
    "smoke:local": "node scripts/db-lock.mjs -- node scripts/smoke-local.mjs",
    "web:env": "node scripts/web-env.mjs",
    "dev:web": "npm run dev -w @orc/web",
    "dev:clock": "node scripts/dev-clock.mjs",
    "build:web": "npm run build -w @orc/web",
    "deploy:web": "node scripts/deploy-web.mjs",
    "tone-bible:sync": "node scripts/sync-tone-bible.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "supabase": "^2.122.0",
    "typescript": "~5.8.3"
  }
}
