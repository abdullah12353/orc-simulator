{
  "name": "orc-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @orc/web && npm run typecheck -w @orc/clock",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/content/test/**/*.test.ts\" \"packages/sim/test/**/*.test.ts\"",
    "test:db": "node scripts/test-db.mjs",
    "test:db:only": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"packages/server/test/**/*.test.ts\"",
    "content:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-content.ts",
    "db:start": "supabase start",
    "dev:web": "npm run dev -w @orc/web",
    "dev:clock": "node scripts/dev-clock.mjs",
    "build:web": "npm run build -w @orc/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "supabase": "^2.122.0",
    "typescript": "~5.8.3"
  }
}
